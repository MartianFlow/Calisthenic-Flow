{
  "name": "calisthenic-flow",
  "version": "2.0.0",
  "private": true,
  "description": "App personal de calistenia (PWA). Las dependencias son solo para las pruebas e2e.",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=iphone-chromium",
    "test:e2e:webkit": "playwright test --project=iphone-webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
